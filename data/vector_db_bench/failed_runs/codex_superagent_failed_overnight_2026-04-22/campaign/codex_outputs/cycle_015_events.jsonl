{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' .meta_codex/tools/capture_benchmark_lanes\"","aggregated_output":"#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport random\nimport socket\nimport struct\nimport subprocess\nimport tempfile\nimport threading\nimport time\nfrom pathlib import Path\n\n\nBENCHMARK_BIN = Path(\"/opt/vector-db-bench/benchmark/target/release/vector-db-benchmark\")\nDATA_DIR = Path(\"/opt/vdb-data\")\nMAX_RESULTS = 10\n\n\ndef float_bits(value: float) -> int:\n    return struct.unpack(\"<I\", struct.pack(\"<f\", value))[0]\n\n\ndef query_key(vector: list[float]) -> tuple[int, ...]:\n    return tuple(float_bits(value) for value in vector)\n\n\ndef build_query_id_map(query_path: Path) -> dict[tuple[int, ...], int]:\n    queries = json.loads(query_path.read_text(encoding=\"utf-8\"))\n    mapping: dict[tuple[int, ...], int] = {}\n    for query_id, query in enumerate(queries):\n        mapping[query_key(query[\"vector\"])] = query_id\n    return mapping\n\n\ndef load_queries(query_path: Path) -> list[dict]:\n    return json.loads(query_path.read_text(encoding=\"utf-8\"))\n\n\ndef parse_one_request(buffer: bytearray):\n    header_end = buffer.find(b\"\\r\\n\\r\\n\")\n    if header_end < 0:\n        return None\n\n    headers = bytes(buffer[:header_end])\n    body_start = header_end + 4\n    content_length = None\n    for line in headers.split(b\"\\r\\n\")[1:]:\n        name, _, value = line.partition(b\":\")\n        if name.lower() == b\"content-length\":\n            content_length = int(value.strip() or b\"0\")\n            break\n\n    if content_length is None:\n        raise RuntimeError(\"missing content-length\")\n\n    body_end = body_start + content_length\n    if len(buffer) < body_end:\n        return None\n\n    raw = bytes(buffer[:body_end])\n    del buffer[:body_end]\n    request_line = headers.split(b\"\\r\\n\", 1)[0].decode(\"ascii\", errors=\"replace\")\n    return {\n        \"request_line\": request_line,\n        \"body\": raw[body_start:body_end],\n    }\n\n\ndef build_search_response() -> bytes:\n    body = b'{\"results\":[{\"id\":0,\"distance\":0},{\"id\":1,\"distance\":1},{\"id\":2,\"distance\":2},{\"id\":3,\"distance\":3},{\"id\":4,\"distance\":4},{\"id\":5,\"distance\":5},{\"id\":6,\"distance\":6},{\"id\":7,\"distance\":7},{\"id\":8,\"distance\":8},{\"id\":9,\"distance\":9}]}'\n    return (\n        b\"HTTP/1.1 200 OK\\r\\n\"\n        + f\"Content-Length: {len(body)}\\r\\n\\r\\n\".encode(\"ascii\")\n        + body\n    )\n\n\ndef build_insert_response(inserted: int) -> bytes:\n    body = json.dumps({\"status\": \"ok\", \"inserted\": inserted}, separators=(\",\", \":\")).encode(\n        \"utf-8\"\n    )\n    return (\n        b\"HTTP/1.1 200 OK\\r\\n\"\n        + f\"Content-Length: {len(body)}\\r\\n\\r\\n\".encode(\"ascii\")\n        + body\n    )\n\n\ndef load_bulk_inserted(body: bytes) -> int:\n    payload = json.loads(body)\n    vectors = payload.get(\"vectors\", [])\n    if not isinstance(vectors, list):\n        return 0\n    return len(vectors)\n\n\ndef handle_connection(\n    conn: socket.socket,\n    addr: tuple[str, int],\n    connection_id: int,\n    captured: list[dict],\n    lock: threading.Lock,\n    stop: threading.Event,\n    query_ids: dict[tuple[int, ...], int],\n) -> None:\n    buffer = bytearray()\n    connection_seq = 0\n    try:\n        while not stop.is_set():\n            chunk = conn.recv(65536)\n            if not chunk:\n                return\n            buffer.extend(chunk)\n            while True:\n                parsed = parse_one_request(buffer)\n                if parsed is None:\n                    break\n\n                request_line = parsed[\"request_line\"]\n                path = request_line.split(\" \")[1]\n                captured_record = {\n                    \"connection_id\": connection_id,\n                    \"client_addr\": f\"{addr[0]}:{addr[1]}\",\n                    \"connection_seq\": connection_seq,\n                    \"path\": path,\n                    \"request_line\": request_line,\n                    \"received_at\": time.time(),\n                }\n\n                if path == \"/search\":\n                    payload = json.loads(parsed[\"body\"])\n                    query_vector = payload.get(\"vector\", [])\n                    query_id = query_ids.get(query_key(query_vector))\n                    captured_record[\"query_id\"] = query_id\n                    conn.sendall(build_search_response())\n                elif path == \"/bulk_insert\":\n                    inserted = load_bulk_inserted(parsed[\"body\"])\n                    captured_record[\"inserted\"] = inserted\n                    conn.sendall(build_insert_response(inserted))\n                else:\n                    body = b'{\"status\":\"ok\"}'\n                    conn.sendall(\n                        b\"HTTP/1.1 200 OK\\r\\n\"\n                        + f\"Content-Length: {len(body)}\\r\\n\\r\\n\".encode(\"ascii\")\n                        + body\n                    )\n\n                with lock:\n                    captured.append(captured_record)\n                connection_seq += 1\n    finally:\n        conn.close()\n\n\ndef run_server(\n    port: int,\n    captured: list[dict],\n    query_ids: dict[tuple[int, ...], int],\n    stop: threading.Event,\n) -> threading.Thread:\n    lock = threading.Lock()\n\n    def worker() -> None:\n        next_connection_id = 1\n        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server:\n            server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n            server.bind((\"127.0.0.1\", port))\n            server.listen()\n            server.settimeout(0.2)\n            while not stop.is_set():\n                try:\n                    conn, addr = server.accept()\n                except TimeoutError:\n                    continue\n                connection_id = next_connection_id\n                next_connection_id += 1\n                thread = threading.Thread(\n                    target=handle_connection,\n                    args=(conn, addr, connection_id, captured, lock, stop, query_ids),\n                    daemon=True,\n                )\n                thread.start()\n\n    thread = threading.Thread(target=worker, daemon=True)\n    thread.start()\n    return thread\n\n\ndef build_expected_measured_order(queries: int, seed: int) -> list[int]:\n    order = list(range(queries))\n    random.Random(seed).shuffle(order)\n    return order\n\n\ndef summarize_searches(\n    captured: list[dict],\n    warmup: int,\n    queries: int,\n    seed: int,\n) -> dict:\n    searches = [record for record in captured if record[\"path\"] == \"/search\"]\n    warmup_records = searches[:warmup]\n    measured_records = searches[warmup : warmup + queries]\n    expected = build_expected_measured_order(queries, seed)\n    actual = [record.get(\"query_id\") for record in measured_records]\n\n    per_connection: dict[int, list[int | None]] = {}\n    for record in measured_records:\n        per_connection.setdefault(record[\"connection_id\"], []).append(record.get(\"query_id\"))\n\n    first_mismatch = None\n    for idx, (actual_id, expected_id) in enumerate(zip(actual, expected)):\n        if actual_id != expected_id:\n            first_mismatch = {\n                \"index\": idx,\n                \"actual\": actual_id,\n                \"expected\": expected_id,\n            }\n            break\n\n    return {\n        \"warmup_searches\": [\n            {\n                \"connection_id\": record[\"connection_id\"],\n                \"query_id\": record.get(\"query_id\"),\n            }\n            for record in warmup_records\n        ],\n        \"measured_total\": len(measured_records),\n        \"global_order_matches_expected\": actual == expected,\n        \"first_mismatch\": first_mismatch,\n        \"expected_prefix\": expected[:32],\n        \"actual_prefix\": actual[:32],\n        \"per_connection\": {\n            str(connection_id): query_ids[:32]\n            for connection_id, query_ids in sorted(per_connection.items())\n        },\n    }\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--warmup\", type=int, default=100)\n    parser.add_argument(\"--queries\", type=int, default=200)\n    parser.add_argument(\"--concurrency\", type=int, default=4)\n    parser.add_argument(\"--batch-size\", type=int, default=1000)\n    parser.add_argument(\"--seed\", type=int, default=42)\n    args = parser.parse_args()\n\n    if not BENCHMARK_BIN.is_file():\n        raise SystemExit(f\"benchmark binary not found: {BENCHMARK_BIN}\")\n\n    query_path = DATA_DIR / \"query_vectors.json\"\n    base_path = DATA_DIR / \"base_vectors.json\"\n    truth_path = DATA_DIR / \"ground_truth.json\"\n    query_ids = build_query_id_map(query_path)\n    all_queries = load_queries(query_path)\n    limited_queries = all_queries[: args.queries]\n    temp_ground_truth = [\n        {\"query_id\": query_id, \"neighbors\": list(range(MAX_RESULTS))}\n        for query_id in range(len(limited_queries))\n    ]\n    temp_base_vectors = [{\"id\": 0, \"vector\": limited_queries[0][\"vector\"]}] if limited_queries else []\n\n    with tempfile.TemporaryDirectory(prefix=\"capture_benchmark_lanes_\") as tmpdir:\n        tmpdir_path = Path(tmpdir)\n        temp_base_path = tmpdir_path / \"base_vectors.json\"\n        temp_query_path = tmpdir_path / \"query_vectors.json\"\n        temp_truth_path = tmpdir_path / \"ground_truth.json\"\n        temp_base_path.write_text(json.dumps(temp_base_vectors), encoding=\"utf-8\")\n        temp_query_path.write_text(json.dumps(limited_queries), encoding=\"utf-8\")\n        temp_truth_path.write_text(json.dumps(temp_ground_truth), encoding=\"utf-8\")\n\n        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:\n            sock.bind((\"127.0.0.1\", 0))\n            port = sock.getsockname()[1]\n\n        captured: list[dict] = []\n        stop = threading.Event()\n        server_thread = run_server(port, captured, query_ids, stop)\n        time.sleep(0.1)\n\n        cmd = [\n            str(BENCHMARK_BIN),\n            \"--server-url\",\n            f\"http://127.0.0.1:{port}\",\n            \"--concurrency\",\n            str(args.concurrency),\n            \"--warmup\",\n            str(args.warmup),\n            \"--batch-size\",\n            str(args.batch_size),\n            \"--max-queries\",\n            str(args.queries),\n            \"--seed\",\n            str(args.seed),\n            \"--base-vectors\",\n            str(temp_base_path),\n            \"--query-vectors\",\n            str(temp_query_path),\n            \"--ground-truth\",\n            str(temp_truth_path),\n            \"--recall-threshold\",\n            \"0.0\",\n        ]\n\n        proc = subprocess.run(\n            cmd,\n            capture_output=True,\n            text=True,\n            timeout=600,\n            check=False,\n        )\n        stop.set()\n        server_thread.join(timeout=1)\n\n        payload = {\n            \"type\": \"CaptureBenchmarkLanes\",\n            \"returncode\": proc.returncode,\n            \"stderr_tail\": proc.stderr[-4000:] if proc.stderr else \"\",\n            \"summary\": summarize_searches(\n                captured=captured,\n                warmup=min(args.warmup, args.queries),\n                queries=args.queries,\n                seed=args.seed,\n            ),\n            \"captured_request_count\": len(captured),\n            \"captured_search_count\": sum(1 for record in captured if record[\"path\"] == \"/search\"),\n            \"captured_connections\": sorted(\n                {record[\"connection_id\"] for record in captured if record[\"path\"] == \"/search\"}\n            ),\n        }\n    print(json.dumps(payload, indent=2))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
