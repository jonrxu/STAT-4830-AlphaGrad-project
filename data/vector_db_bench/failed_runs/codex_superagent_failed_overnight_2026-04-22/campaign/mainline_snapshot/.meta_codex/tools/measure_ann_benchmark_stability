#!/usr/bin/env python3

import argparse
import json
import statistics
import subprocess
import sys
from pathlib import Path


def parse_args():
    parser = argparse.ArgumentParser(
        description=(
            "Repeat measure_ann_benchmark for one ANN point and summarize the QPS/recall "
            "spread. Use this before trusting a narrow ANN point or u8-routing A/B on the "
            "exact gate."
        )
    )
    parser.add_argument("--count", type=int, default=3)
    parser.add_argument("--include-payloads", action="store_true")
    args, forwarded = parser.parse_known_args()
    if args.count <= 0:
        raise SystemExit("--count must be positive")
    if forwarded[:1] == ["--"]:
        forwarded = forwarded[1:]
    return args, forwarded


def run_json(cmd):
    completed = subprocess.run(cmd, capture_output=True, text=True)
    if completed.returncode != 0:
        if completed.stdout:
            sys.stderr.write(completed.stdout)
        if completed.stderr:
            sys.stderr.write(completed.stderr)
        raise SystemExit(completed.returncode)

    stdout = completed.stdout.strip()
    try:
        return json.loads(stdout)
    except json.JSONDecodeError as exc:
        sys.stderr.write(stdout + "\n")
        raise SystemExit(f"failed to parse JSON from {' '.join(cmd)}: {exc}") from exc


def metric_fields(payload):
    benchmark = payload.get("benchmark") or {}
    return (
        float(benchmark.get("qps", 0.0) or 0.0),
        float(benchmark.get("recall", 0.0) or 0.0),
        bool(benchmark.get("recall_passed", False)),
    )


def summarize(values):
    if not values:
        return None
    return {
        "mean": statistics.fmean(values),
        "median": statistics.median(values),
        "min": min(values),
        "max": max(values),
        "stdev": statistics.stdev(values) if len(values) > 1 else 0.0,
    }


def main():
    args, forwarded = parse_args()
    tool = Path(__file__).resolve().parent / "measure_ann_benchmark"
    cmd = [str(tool), *forwarded]

    runs = []
    for run_idx in range(1, args.count + 1):
        payload = run_json(cmd)
        qps, recall, passed = metric_fields(payload)
        sys.stderr.write(
            f"run {run_idx}: qps={qps:.2f} recall={recall:.4f} passed={passed}\n"
        )
        run_summary = {
            "run": run_idx,
            "qps": qps,
            "recall": recall,
            "recall_passed": passed,
        }
        if args.include_payloads:
            run_summary["payload"] = payload
        runs.append(run_summary)

    qps_values = [run["qps"] for run in runs]
    recall_values = [run["recall"] for run in runs]
    passed_runs = [run for run in runs if run["recall_passed"]]
    best_valid = max(passed_runs, key=lambda run: run["qps"], default=None)

    result = {
        "command": cmd,
        "count": args.count,
        "runs": runs,
        "qps": summarize(qps_values),
        "recall": summarize(recall_values),
        "passed_runs": len(passed_runs),
        "best_valid_run": best_valid,
        "type": "MeasureAnnBenchmarkStability",
    }
    json.dump(result, sys.stdout, indent=2)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
