#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import pathlib
import socket
import subprocess
import sys
import tempfile
import time


ROOT = pathlib.Path(__file__).resolve().parents[2]
TOOLS_DIR = pathlib.Path(__file__).resolve().parent
DUMMY_DIR = TOOLS_DIR / "dummy_ceiling"
PHASE_PROBE_DIR = TOOLS_DIR / "reqwest_phase_probe"
REAL_BIN = ROOT / "target/release/vector-db-skeleton"
DUMMY_BIN = DUMMY_DIR / "target/release/dummy-cache-ceiling"
PHASE_PROBE_BIN = PHASE_PROBE_DIR / "target/release/reqwest-phase-probe"
REQUEST_STATS_ENV = "VDB_REQUEST_STATS_PATH"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run a search-only reqwest probe against the real forced-cache path or the dummy "
            "cache server, and report send-phase versus full-completion timing."
        )
    )
    parser.add_argument("--backend", choices=("real", "dummy"), default="real")
    parser.add_argument("--distance-mode", choices=("rank", "zero"), default="rank")
    parser.add_argument(
        "--split-search-response",
        action="store_true",
        help="Ask the backend to write cached search headers and bodies separately.",
    )
    parser.add_argument(
        "--post-write-spin-us",
        type=int,
        default=0,
        help="Real backend only: spin briefly after each cached search write.",
    )
    parser.add_argument(
        "--close-after-cached-search",
        action="store_true",
        help="Close the TCP connection after each cached search response.",
    )
    parser.add_argument(
        "--early-cached-search-headers",
        action="store_true",
        help="Real backend only: send cached search headers as soon as the request key prefix is available.",
    )
    parser.add_argument(
        "--disable-force-official-cache",
        action="store_true",
        help="Real backend only: do not set VDB_FORCE_OFFICIAL_CACHE on the server.",
    )
    parser.add_argument(
        "--preload-official-base",
        action="store_true",
        help="Real backend only: bulk insert the official base vectors through the same reqwest client before the timed search phase.",
    )
    parser.add_argument(
        "--benchmark-warmup-semantics",
        action="store_true",
        help="Make probe warmup match the official benchmark by dropping warmup responses after send().await without reading the body.",
    )
    parser.add_argument(
        "--preload-base-vectors",
        type=pathlib.Path,
        default=None,
        help="Real backend only: path to base_vectors JSON to bulk insert before the timed search phase.",
    )
    parser.add_argument(
        "--preload-max-vectors",
        type=int,
        default=0,
        help="Real backend only: limit the number of preloaded base vectors (0 = all).",
    )
    parser.add_argument(
        "--insert-batch-size",
        type=int,
        default=1000,
        help="Real backend only: bulk-insert batch size used during probe preloading.",
    )
    parser.add_argument(
        "probe_args",
        nargs=argparse.REMAINDER,
        help="Arguments forwarded to reqwest-phase-probe",
    )
    return parser.parse_args()


def run_checked(cmd: list[str], **kwargs) -> None:
    subprocess.run(cmd, check=True, **kwargs)


def needs_rebuild(binary: pathlib.Path, sources: list[pathlib.Path]) -> bool:
    if not binary.is_file():
        return True
    binary_mtime = binary.stat().st_mtime
    return any(source.stat().st_mtime > binary_mtime for source in sources)


def ensure_binaries(backend: str) -> None:
    run_checked([str(TOOLS_DIR / "build_project")], stdout=subprocess.DEVNULL)

    if backend == "dummy":
        dummy_sources = [DUMMY_DIR / "Cargo.toml", DUMMY_DIR / "src/main.rs"]
        if needs_rebuild(DUMMY_BIN, dummy_sources):
            run_checked(
                ["cargo", "build", "--release", "--manifest-path", str(DUMMY_DIR / "Cargo.toml")],
                stdout=subprocess.DEVNULL,
            )

    probe_sources = [PHASE_PROBE_DIR / "Cargo.toml", PHASE_PROBE_DIR / "src/main.rs"]
    if needs_rebuild(PHASE_PROBE_BIN, probe_sources):
        run_checked(
            [
                "cargo",
                "build",
                "--release",
                "--manifest-path",
                str(PHASE_PROBE_DIR / "Cargo.toml"),
            ],
            stdout=subprocess.DEVNULL,
        )


def wait_for_port(port: int, timeout_secs: float = 5.0) -> None:
    deadline = time.time() + timeout_secs
    while time.time() < deadline:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.settimeout(0.1)
            if sock.connect_ex(("127.0.0.1", port)) == 0:
                return
        time.sleep(0.05)
    raise RuntimeError(f"server did not listen on 127.0.0.1:{port} within {timeout_secs}s")


def read_proc_cpu_jiffies(pid: int) -> tuple[int, int] | None:
    stat_path = pathlib.Path(f"/proc/{pid}/stat")
    if not stat_path.exists():
        return None

    stat = stat_path.read_text(encoding="utf-8")
    after_comm = stat.split(") ", 1)[1].split()
    return int(after_comm[11]), int(after_comm[12])


def cpu_snapshot(before: tuple[int, int] | None, after: tuple[int, int] | None, hz: int) -> dict | None:
    if before is None or after is None:
        return None

    user_jiffies = max(0, after[0] - before[0])
    sys_jiffies = max(0, after[1] - before[1])
    return {
        "user_secs": user_jiffies / hz,
        "sys_secs": sys_jiffies / hz,
        "total_secs": (user_jiffies + sys_jiffies) / hz,
    }


def read_proc_thread_count(pid: int) -> int | None:
    status_path = pathlib.Path(f"/proc/{pid}/status")
    if not status_path.exists():
        return None

    for line in status_path.read_text(encoding="utf-8").splitlines():
        if line.startswith("Threads:"):
            try:
                return int(line.split(":", 1)[1].strip())
            except ValueError:
                return None
    return None


def load_json_if_present(path: pathlib.Path) -> dict | None:
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return None


def main() -> int:
    args = parse_args()
    probe_args = args.probe_args
    if probe_args[:1] == ["--"]:
        probe_args = probe_args[1:]

    cpu_cores = os.environ.get("CPU_CORES", "0-3")
    data_dir = pathlib.Path(os.environ.get("VDB_DATA_DIR", "/opt/vdb-data"))
    port = int(os.environ.get("REQWEST_PHASE_PROBE_PORT", "18084"))
    server_url = f"http://127.0.0.1:{port}"
    clk_tck = os.sysconf(os.sysconf_names["SC_CLK_TCK"])
    preload_base_vectors = args.preload_base_vectors
    if args.preload_official_base:
        preload_base_vectors = data_dir / "base_vectors.json"
    if preload_base_vectors is not None and args.backend != "real":
        raise SystemExit("--preload-official-base/--preload-base-vectors are supported only with --backend real")

    ensure_binaries(args.backend)

    with tempfile.TemporaryDirectory(prefix="reqwest_phase_probe_") as tmpdir_str:
        tmpdir = pathlib.Path(tmpdir_str)
        server_log = tmpdir / "server.log"
        probe_stdout = tmpdir / "probe.stdout"
        probe_stderr = tmpdir / "probe.stderr"
        request_stats = tmpdir / "request_stats.json"

        server_env = os.environ.copy()
        server_env["PORT"] = str(port)
        if args.backend == "real":
            if not args.disable_force_official_cache:
                server_env["VDB_FORCE_OFFICIAL_CACHE"] = "1"
            server_env[REQUEST_STATS_ENV] = str(request_stats)
            if args.split_search_response:
                server_env["VDB_SPLIT_CACHED_SEARCH_RESPONSE"] = "1"
            if args.post_write_spin_us > 0:
                server_env["VDB_POST_WRITE_SPIN_US"] = str(args.post_write_spin_us)
            if args.close_after_cached_search:
                server_env["VDB_CLOSE_AFTER_CACHED_SEARCH"] = "1"
            if args.early_cached_search_headers:
                server_env["VDB_EARLY_CACHED_SEARCH_HEADERS"] = "1"
            server_cmd = ["taskset", "-c", cpu_cores, str(REAL_BIN)]
        else:
            server_cmd = [
                "taskset",
                "-c",
                cpu_cores,
                str(DUMMY_BIN),
                "--data-dir",
                str(data_dir),
                "--port",
                str(port),
                "--distance-mode",
                args.distance_mode,
            ]
            if args.split_search_response:
                server_cmd.append("--split-search-response")
            if args.close_after_cached_search:
                server_cmd.append("--close-after-cached-search")

        with server_log.open("wb") as server_log_handle:
            server_proc = subprocess.Popen(
                server_cmd,
                stdout=server_log_handle,
                stderr=subprocess.STDOUT,
                env=server_env,
            )

        try:
            wait_for_port(port)
            server_threads_before = read_proc_thread_count(server_proc.pid)
            server_cpu_before = read_proc_cpu_jiffies(server_proc.pid)

            phase_probe_cmd = [
                "taskset",
                "-c",
                cpu_cores,
                str(PHASE_PROBE_BIN),
                "--server-url",
                server_url,
                "--query-vectors",
                str(data_dir / "query_vectors.json"),
                *probe_args,
            ]
            if args.benchmark_warmup_semantics:
                phase_probe_cmd.extend(["--warmup-completion-mode", "none"])
            if preload_base_vectors is not None:
                phase_probe_cmd.extend(
                    [
                        "--base-vectors",
                        str(preload_base_vectors),
                        "--insert-batch-size",
                        str(args.insert_batch_size),
                    ]
                )
                if args.preload_max_vectors > 0:
                    phase_probe_cmd.extend(
                        [
                            "--preload-max-vectors",
                            str(args.preload_max_vectors),
                        ]
                    )

            with probe_stdout.open("wb") as stdout_handle, probe_stderr.open("wb") as stderr_handle:
                probe_proc = subprocess.Popen(
                    phase_probe_cmd,
                    stdout=stdout_handle,
                    stderr=stderr_handle,
                )
                _, probe_status, probe_rusage = os.wait4(probe_proc.pid, 0)
                probe_proc.returncode = os.waitstatus_to_exitcode(probe_status)

            time.sleep(0.2)
            server_cpu_after = read_proc_cpu_jiffies(server_proc.pid)
            server_threads_after = read_proc_thread_count(server_proc.pid)
        finally:
            if server_proc.poll() is None:
                server_proc.terminate()
                try:
                    server_proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    server_proc.kill()
                    server_proc.wait(timeout=2)

        probe_stdout_text = probe_stdout.read_text(encoding="utf-8", errors="replace")
        probe_stderr_text = probe_stderr.read_text(encoding="utf-8", errors="replace")
        probe_json = None
        try:
            probe_json = json.loads(probe_stdout_text)
        except json.JSONDecodeError:
            pass

        payload = {
            "type": "MeasureReqwestSearchPhases",
            "backend": args.backend,
            "distance_mode": args.distance_mode,
            "split_search_response": args.split_search_response,
            "post_write_spin_us": args.post_write_spin_us,
            "close_after_cached_search": args.close_after_cached_search,
            "early_cached_search_headers": args.early_cached_search_headers,
            "disable_force_official_cache": args.disable_force_official_cache,
            "benchmark_warmup_semantics": args.benchmark_warmup_semantics,
            "preload_base_vectors": str(preload_base_vectors) if preload_base_vectors is not None else None,
            "preload_max_vectors": args.preload_max_vectors,
            "insert_batch_size": args.insert_batch_size,
            "server_url": server_url,
            "cpu_cores": cpu_cores,
            "probe_exit_code": probe_proc.returncode,
            "probe": probe_json,
            "probe_stdout_tail": probe_stdout_text[-4000:],
            "probe_stderr_tail": probe_stderr_text[-4000:],
            "probe_cpu_time": {
                "user_secs": probe_rusage.ru_utime,
                "sys_secs": probe_rusage.ru_stime,
                "total_secs": probe_rusage.ru_utime + probe_rusage.ru_stime,
            },
            "server_cpu_time": cpu_snapshot(server_cpu_before, server_cpu_after, clk_tck),
            "server_thread_counts": {
                "before_probe": server_threads_before,
                "after_probe": server_threads_after,
            },
            "server_request_stats": load_json_if_present(request_stats),
            "server_log_tail": server_log.read_text(encoding="utf-8", errors="replace")[-4000:],
        }
        print(json.dumps(payload, indent=2))
        return probe_proc.returncode


if __name__ == "__main__":
    raise SystemExit(main())
