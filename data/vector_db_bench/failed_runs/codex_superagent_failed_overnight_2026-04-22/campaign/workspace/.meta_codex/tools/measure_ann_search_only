if [ -n "$BLOCK_BOUND_PRUNE_OVERRIDE" ]; then
  SERVER_ENV+=(VDB_ENABLE_BLOCK_BOUND_PRUNE="$BLOCK_BOUND_PRUNE_OVERRIDE")
  ANN_ENV_JSON="$(python3 - "$ANN_ENV_JSON" "$BLOCK_BOUND_PRUNE_OVERRIDE" <<'PY'
