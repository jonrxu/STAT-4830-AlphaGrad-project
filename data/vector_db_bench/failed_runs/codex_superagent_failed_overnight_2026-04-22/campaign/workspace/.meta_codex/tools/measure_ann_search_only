print(json.dumps(payload))
PY
)"
fi
if [ -n "$VECTOR_RADIUS_PRUNE_OVERRIDE" ]; then
  SERVER_ENV+=(VDB_ENABLE_VECTOR_RADIUS_PRUNE="$VECTOR_RADIUS_PRUNE_OVERRIDE")
  ANN_ENV_JSON="$(python3 - "$ANN_ENV_JSON" "$VECTOR_RADIUS_PRUNE_OVERRIDE" <<'PY'
