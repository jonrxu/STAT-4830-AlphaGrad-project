env "${SERVER_ENV[@]}" taskset -c "$CPU_CORES" "$SERVER_BIN" >"$SERVER_LOG" 2>&1 &
SERVER_PID="$!"

for _ in $(seq 1 200); do
  if bash -lc "exec 3<>/dev/tcp/127.0.0.1/${PORT}" >/dev/null 2>&1; then
    break
  fi
  sleep 0.05
done

PRIME_BUILD_JSON=""
if [ "$PRIME_BUILD" = "1" ]; then
  PRIME_BUILD_JSON="$(
    taskset -c "$CPU_CORES" "$DIR/replay_search_bodies_fast" \
      --server-url "$SERVER_URL" \
      --data-dir "$DATA_DIR" \
      --ground-truth "$DATA_DIR/ground_truth.json" \
      --queries 1 \
      --warmup 0 \
      --concurrency 1
  )"
fi

RESULT_JSON="$(
  taskset -c "$CPU_CORES" "$DIR/replay_search_bodies_fast" \
    --server-url "$SERVER_URL" \
    --data-dir "$DATA_DIR" \
    --ground-truth "$DATA_DIR/ground_truth.json" \
    "${CLIENT_ARGS[@]}"
)"

REQUEST_STATS_JSON=""
REQUEST_STATS_ERROR=""
if [ "$INCLUDE_REQUEST_STATS" = "1" ]; then
  for _ in $(seq 1 20); do
    if [ -s "$REQUEST_STATS_PATH" ]; then
      break
    fi
    sleep 0.05
  done
  if [ -s "$REQUEST_STATS_PATH" ]; then
    REQUEST_STATS_JSON="$(cat "$REQUEST_STATS_PATH")"
  else
    REQUEST_STATS_ERROR="request stats file was not created"
  fi
fi

ANN_STATS_JSON=""
ANN_STATS_ERROR=""
if [ "$INCLUDE_ANN_STATS" = "1" ]; then
  for _ in $(seq 1 20); do
    if [ -s "$ANN_STATS_PATH" ]; then
      break
    fi
    sleep 0.05
  done
  if [ -s "$ANN_STATS_PATH" ]; then
    ANN_STATS_JSON="$(cat "$ANN_STATS_PATH")"
  else
    ANN_STATS_ERROR="ANN stats file was not created"
  fi
fi

python3 - "$ANN_ENV_JSON" "$RESULT_JSON" "$REQUEST_STATS_JSON" "$REQUEST_STATS_ERROR" "$INCLUDE_REQUEST_STATS" "$ANN_STATS_JSON" "$ANN_STATS_ERROR" "$INCLUDE_ANN_STATS" "$PRIME_BUILD_JSON" "$PRIME_BUILD" <<'PY'
import json
import sys

result = json.loads(sys.argv[2])
result["type"] = "MeasureAnnSearchOnly"
result["ann_env"] = json.loads(sys.argv[1])
if sys.argv[5] == "1":
    raw_stats = sys.argv[3]
    if raw_stats:
        try:
            result["request_stats"] = json.loads(raw_stats)
            result["request_stats_error"] = None
        except json.JSONDecodeError as exc:
            result["request_stats"] = None
            result["request_stats_error"] = f"failed to parse request stats: {exc}"
    else:
        result["request_stats"] = None
        result["request_stats_error"] = sys.argv[4] or "request stats were not captured"
if sys.argv[8] == "1":
    raw_ann_stats = sys.argv[6]
    if raw_ann_stats:
        try:
            result["ann_stats"] = json.loads(raw_ann_stats)
            result["ann_stats_error"] = None
        except json.JSONDecodeError as exc:
            result["ann_stats"] = None
            result["ann_stats_error"] = f"failed to parse ANN stats: {exc}"
    else:
        result["ann_stats"] = None
        result["ann_stats_error"] = sys.argv[7] or "ANN stats were not captured"
if sys.argv[10] == "1":
    raw_prime = sys.argv[9]
    if raw_prime:
        try:
            result["prime_build"] = json.loads(raw_prime)
        except json.JSONDecodeError:
            result["prime_build"] = raw_prime
    else:
        result["prime_build"] = None
print(json.dumps(result, indent=2, sort_keys=True))
